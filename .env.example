# ─── Firebase Client SDK (public — safe to expose to the browser) ───────────
# Get these from: Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Firebase Admin SDK (server-side only — NEVER expose to the browser) ────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download the JSON, then copy the fields below.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Paste the private key exactly as it appears in the JSON (with \n escape sequences).
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── Paystack (server-side only — NEVER expose to the browser) ───────────────
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=""

# ─── App URL (used for Paystack callback redirect) ────────────────────────────
# Production: your deployed domain e.g. https://yourdomain.com
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=""

# ─── Webhook Relay ────────────────────────────────────────────────────────────
# Point your Paystack "Live Webhook URL" to: https://yourdomain.com/api/webhooks/relay
# Then register each project's internal webhook handler URL here.
# The relay reads WEBHOOK_URL_<PROJECT> where <PROJECT> matches the "project"
# field you embed in Paystack metadata at payment initialization.
WEBHOOK_URL_REST=""
WEBHOOK_URL_DISPATCHER=""
WEBHOOK_URL_KEKEV2=""

# ─── Google Business Profile OAuth (server-side only — NEVER expose to browser) ─
# Set up at: console.cloud.google.com → APIs & Services → Credentials
# Enable: "My Business Account Management API", "My Business Business Information API"
# Create OAuth 2.0 Client ID (Web application type)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# Leave blank to run in manual "Setup Assistant" fallback mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Production: https://yourdomain.com/api/admin/google-business/callback
# Local dev:  http://localhost:3000/api/admin/google-business/callback
GOOGLE_REDIRECT_URI=""
# 32-byte AES-256-GCM key for encrypting Google OAuth tokens at rest.
# REQUIRED when GOOGLE_CLIENT_ID is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# ─── Telegram (order notifications + admin alerts) ───────────────────────────
# Bot token shared by per-restaurant order alerts and admin setup-help alerts.
# Get from: @BotFather on Telegram → /newbot (or use your existing bot token).
TELEGRAM_BOT_TOKEN=""
# Optional. Telegram chat ID for the RestoFlow ops account or group.
# When set, the admin receives a Telegram message whenever a restaurant owner
# clicks "Request Setup Help" on their dashboard.
# If not set, requests are saved to Firestore (assistanceStatus: "open") but
# no Telegram alert is sent — the notification can be wired at any time by
# adding this variable with no code changes required.
# To find your chat ID: message @userinfobot on Telegram.
ADMIN_TELEGRAM_CHAT_ID=""

# ─── AI helpers (optional — Phase D) ────────────────────────────────────────
# Powers the "Generate with AI" / "Improve with AI" buttons in the admin.
# If not set, all AI helper buttons are hidden and setup works normally without them.
# Uses Google Gemini 1.5 Flash (free tier available — no credit card required).
# Get a free key from: aistudio.google.com → Get API Key
GEMINI_API_KEY=""

# ─── Support contact (public — shown in admin UI) ────────────────────────────
# WhatsApp number for the domain-setup help button (digits only, no + or spaces).
# Example: 2347012345678  (country code + number)
# Leave blank to hide the WhatsApp help button entirely.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
