# ─────────────────────────────────────────────────────────────────────────────
# RestoFlow STAGING — non-production only.
#
# Copy to Vercel's Preview environment. NEVER copy a production value into this
# file: the whole point is that a mistake here cannot reach a live restaurant.
#
# Every Firebase command against this environment must name the project
# explicitly (--project restoflow-staging). Never run a bare `firebase deploy`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (STAGING PROJECT — must NOT be the production project id) ───────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="restoflow-staging.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="restoflow-staging"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="restoflow-staging.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

FIREBASE_ADMIN_PROJECT_ID="restoflow-staging"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Paystack — TEST keys only ────────────────────────────────────────────────
# A live secret key here would take real money from a synthetic customer.
PAYSTACK_SECRET_KEY="sk_test_..."

NEXT_PUBLIC_APP_URL=""   # the Vercel PREVIEW url for the branch

# ── Marketplace ──────────────────────────────────────────────────────────────
# On in staging so the flow can be exercised; OFF in production until launch.
MARKETPLACE_ENABLED="true"
MARKETPLACE_PAYMENTS_ENABLED="true"

# ── Dispatcher integration (points at DISPATCHER STAGING) ───────────────────
DELIVERY_INTEGRATION_ENABLED="true"
DELIVERY_ENVIRONMENT="staging"
DISPATCHER_API_BASE_URL="https://us-central1-pack-delivery-staging.cloudfunctions.net/marketplaceApi"
DISPATCHER_API_KEY=""            # the staging partner key, from Dispatcher's admin dashboard
DISPATCHER_SIGNING_SECRET=""     # signs OUR requests to Dispatcher
DISPATCHER_WEBHOOK_SECRET=""     # verifies Dispatcher's events to US — a DIFFERENT secret

# ── Cron ─────────────────────────────────────────────────────────────────────
# Without this the sweep endpoint is a public way to make the platform call
# Dispatcher.
CRON_SECRET=""

# ── Off in staging ───────────────────────────────────────────────────────────
STOREFRONT_ANALYTICS_ENABLED="false"
POS_REQUIRE_IDEMPOTENCY_KEY="false"
