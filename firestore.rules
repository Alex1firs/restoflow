rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Is this user authenticated and does their restaurantSlug match?
    // Works for owner, manager, and staff — all share the same restaurantSlug.
    function isRestaurantMember(restaurantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantSlug == restaurantId;
    }

    // Same check using the resource's restaurantId field (for existing docs)
    function isMemberOf(restaurantId) {
      return isRestaurantMember(restaurantId);
    }

    // Only owner or manager may write menu items
    function isManagerOrOwner(restaurantId) {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'owner');
      return isRestaurantMember(restaurantId) && role in ['owner', 'manager'];
    }

    // ─── Plans ──────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read:  if true;
      allow write: if false;
    }

    // ─── Restaurants ────────────────────────────────────────────────────────────
    match /restaurants/{slug} {
      allow read:  if true;
      allow write: if false;
    }

    // ─── Menu Items ─────────────────────────────────────────────────────────────
    match /menu_items/{itemId} {
      allow read:   if true;
      allow create: if isManagerOrOwner(request.resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId);
      allow delete: if isManagerOrOwner(resource.data.restaurantId);
    }

    // ─── Prepared Items ─────────────────────────────────────────────────────────
    match /prepared_items/{itemId} {
      allow read:   if true;
      allow create: if isManagerOrOwner(request.resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId);
      allow delete: if isManagerOrOwner(resource.data.restaurantId);
    }

    // ─── Waiters ────────────────────────────────────────────────────────────────
    match /waiters/{waiterId} {
      allow read:   if true;
      allow create: if isRestaurantMember(request.resource.data.restaurantId);
      allow update: if isRestaurantMember(resource.data.restaurantId);
      allow delete: if isRestaurantMember(resource.data.restaurantId);
    }

    // ─── Orders ─────────────────────────────────────────────────────────────────
    // Direct client reads are restricted to restaurant members only.
    // Public order tracking goes through /api/track/[orderId]/status which validates
    // the tracking token server-side and returns only {status, paymentStatus}.
    match /orders/{orderId} {
      allow create: if false;
      allow get:    if isMemberOf(resource.data.restaurantId);
      allow list:   if isMemberOf(resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason'])
                    && request.resource.data.status in ['pending', 'preparing', 'ready', 'completed', 'rejected'];
      allow delete: if false;
    }

    // ─── Onboardings ────────────────────────────────────────────────────────────
    match /onboardings/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Payments ───────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:  if isMemberOf(resource.data.restaurantId);
      allow write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────────────
    // Each user can read their own profile. Staff can list their restaurant's users
    // via the staff management page (server-side Admin SDK).
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ─── AI Usage / Audit (ai_usage) ─────────────────────────────────────────────
    // AI request audit + token/cost records. Written ONLY by the server (Admin SDK,
    // which bypasses these rules); never read or written by clients.
    match /ai_usage/{recordId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── AI Daily Briefs (ai_briefs) ─────────────────────────────────────────────
    // Generated morning briefs. Written by the server (cron / manual refresh, Admin
    // SDK) and served to clients via /api/admin/ai/brief — never read/written directly.
    match /ai_briefs/{briefId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── AI Recommendations (ai_recommendations) ─────────────────────────────────
    // Generated recommendations + owner accept/dismiss status. Written by the server
    // (Admin SDK) and served via /api/admin/ai/recommendations — never client-direct.
    match /ai_recommendations/{recId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── AI Forecasts (ai_forecasts) ─────────────────────────────────────────────
    // Deterministic demand/revenue forecasts. Written by the server (Admin SDK) and
    // served via /api/admin/ai/forecast — never client-direct.
    match /ai_forecasts/{forecastId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── AI Purchasing Plans (ai_purchase_plans) ─────────────────────────────────
    // Forecast-driven prep & purchasing plans. Written by the server (Admin SDK) and
    // served via /api/admin/ai/purchasing — never client-direct.
    match /ai_purchase_plans/{planId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── AI Automation (rules / automations / executions) ────────────────────────
    // Approval-first automation config, instances, and the execution audit trail.
    // Written by the server (Admin SDK) and served via /api/admin/ai/automation —
    // never client-direct. The execution records are the ONLY writes automation makes;
    // core business collections remain read-only.
    match /ai_automation_rules/{ruleId} {
      allow read:  if false;
      allow write: if false;
    }
    match /ai_automations/{automationId} {
      allow read:  if false;
      allow write: if false;
    }
    match /ai_automation_executions/{executionId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Restaurant Operating Profile (ai_operating_profiles + audit) ────────────
    // Restaurant-scoped operating preferences that influence AI reasoning. Written by
    // the server (Admin SDK) and served via /api/admin/ai/profile — never client-direct.
    match /ai_operating_profiles/{profileId} {
      allow read:  if false;
      allow write: if false;
    }
    match /ai_operating_profile_audit/{auditId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Storefront Funnel Analytics (storefront_stats_daily) ────────────────────
    // Per-restaurant, per-day funnel rollups. Written ONLY by the server (Admin
    // SDK, which bypasses these rules) via /api/storefront/events and server-side
    // money-truth emits. Served to dashboards via /api/admin/analytics (own
    // restaurant only) and /api/super-admin/analytics (platform-wide). Never
    // read or written directly by any client.
    match /storefront_stats_daily/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Food Discovery Engine (discovery_dishes + discovery_restaurants) ─────────
    // Denormalized, read-only projection of the transactional core, built by the
    // server (Admin SDK, which bypasses these rules) via the discovery indexer /
    // backfill. Served ONLY through /api/discovery/* — never read or written
    // directly by any client.
    match /discovery_dishes/{dishId} {
      allow read:  if false;
      allow write: if false;
    }
    match /discovery_restaurants/{slug} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Marketplace commerce (orders, payments, ledger, outbox) ────────────────
    // The money. Payment intents hold a basket between checkout and capture;
    // marketplace_payments is the per-reference idempotency record; the ledger
    // is append-only financial history; the outbox deduplicates notifications.
    //
    // ALL server-only (Admin SDK bypasses these rules). A customer reaches their
    // own order through /api/mobile/v1, a restaurant through the admin routes,
    // and nobody reaches the ledger from a client at all — a balance a client
    // could write is not a balance.
    match /marketplace_payment_intents/{reference} {
      allow read:  if false;
      allow write: if false;
    }
    match /marketplace_payments/{reference} {
      allow read:  if false;
      allow write: if false;
    }
    match /marketplace_ledger_entries/{entryId} {
      allow read:  if false;
      allow write: if false;
    }
    match /marketplace_notification_outbox/{outboxId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Marketplace delivery integration (Dispatcher) ───────────────────────────
    // Event-replay claims and the support timeline for marketplace deliveries.
    // Written ONLY by the server (Admin SDK, which bypasses these rules) from the
    // signed Dispatcher webhook. The claim document is what makes a redelivered
    // event a no-op; the timeline is what support reads to answer "where is this
    // order?". Neither is ever read or written directly by any client — the
    // customer app reaches delivery state through /api/mobile/v1 only.
    match /marketplace_delivery_events/{eventId} {
      allow read:  if false;
      allow write: if false;
    }
    match /marketplace_delivery_timeline/{entryId} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── POS order idempotency claims ────────────────────────────────────────────
    // One document per (restaurant, localOrderId) cashier transaction, written
    // ONLY by the server (Admin SDK, which bypasses these rules) inside the same
    // transaction that creates the order. This is what makes a duplicate POS
    // submission impossible. Never read or written directly by any client.
    match /pos_order_claims/{claimId} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
