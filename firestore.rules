rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Is this user authenticated and does their restaurantSlug match?
    // Works for owner, manager, and staff — all share the same restaurantSlug.
    function isRestaurantMember(restaurantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantSlug == restaurantId;
    }

    // Same check using the resource's restaurantId field (for existing docs)
    function isMemberOf(restaurantId) {
      return isRestaurantMember(restaurantId);
    }

    // Only owner or manager may write menu items
    function isManagerOrOwner(restaurantId) {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'owner');
      return isRestaurantMember(restaurantId) && role in ['owner', 'manager'];
    }

    // ─── Plans ──────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read:  if true;
      allow write: if false;
    }

    // ─── Restaurants ────────────────────────────────────────────────────────────
    match /restaurants/{slug} {
      allow read:  if true;
      allow write: if false;
    }

    // ─── Menu Items ─────────────────────────────────────────────────────────────
    match /menu_items/{itemId} {
      allow read:   if true;
      allow create: if isManagerOrOwner(request.resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId);
      allow delete: if isManagerOrOwner(resource.data.restaurantId);
    }

    // ─── Prepared Items ─────────────────────────────────────────────────────────
    match /prepared_items/{itemId} {
      allow read:   if true;
      allow create: if isManagerOrOwner(request.resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId);
      allow delete: if isManagerOrOwner(resource.data.restaurantId);
    }

    // ─── Waiters ────────────────────────────────────────────────────────────────
    match /waiters/{waiterId} {
      allow read:   if true;
      allow create: if isRestaurantMember(request.resource.data.restaurantId);
      allow update: if isRestaurantMember(resource.data.restaurantId);
      allow delete: if isRestaurantMember(resource.data.restaurantId);
    }

    // ─── Orders ─────────────────────────────────────────────────────────────────
    // Direct client reads are restricted to restaurant members only.
    // Public order tracking goes through /api/track/[orderId]/status which validates
    // the tracking token server-side and returns only {status, paymentStatus}.
    match /orders/{orderId} {
      allow create: if false;
      allow get:    if isMemberOf(resource.data.restaurantId);
      allow list:   if isMemberOf(resource.data.restaurantId);
      allow update: if isManagerOrOwner(resource.data.restaurantId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason'])
                    && request.resource.data.status in ['pending', 'preparing', 'ready', 'completed', 'rejected'];
      allow delete: if false;
    }

    // ─── Onboardings ────────────────────────────────────────────────────────────
    match /onboardings/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Payments ───────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:  if isMemberOf(resource.data.restaurantId);
      allow write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────────────
    // Each user can read their own profile. Staff can list their restaurant's users
    // via the staff management page (server-side Admin SDK).
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
